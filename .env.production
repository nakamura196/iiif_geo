# 本番は GitHub Pages + 独自ドメイン geo.ldas.jp(ルート配信なので BASE_URL は空)。
# 旧 URL nakamura196.github.io/iiif_geo/ は Pages が geo.ldas.jp へ転送する。
NUXT_PUBLIC_BASE_URL=
NUXT_PUBLIC_ORIGIN=https://geo.ldas.jp

# Google Analytics 4 Measurement ID (公開値). nakamura196.github.io 共通の
# GA4 プロパティに統合 (旧 G-KFB2YWWK4P から移行。過去データは旧プロパティに
# アーカイブとして残置)。dev では gtag は読み込まれない。
NUXT_PUBLIC_GTAG_ID=G-G0619D6ER0